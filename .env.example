# ─────────────────────────────────────────────
#  Violence Detection System — Environment Config
# ─────────────────────────────────────────────

# --- Model Settings ---
MODEL_PATH=models/violence_yolov8.pt        # Path to your trained YOLOv8 weights
CONFIDENCE_THRESHOLD=0.55                   # Detection confidence (0.0 – 1.0)
FRAME_CONSISTENCY=5                         # Consecutive violent frames before alert fires
FPS_TARGET=20                               # Target processing FPS

# --- Video Source ---
# Use 0 for webcam, or an RTSP URL e.g. rtsp://user:pass@192.168.1.100/stream
VIDEO_SOURCE=0

# --- Alert Cooldown ---
ALERT_COOLDOWN_SECONDS=30                   # Minimum seconds between successive alerts

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password             # Use a Gmail App Password (not your main password)
ALERT_RECIPIENTS=security@yourorg.com,admin@yourorg.com

# --- Twilio / WhatsApp ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Twilio sandbox number
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX   # Recipient's WhatsApp number

# --- Storage ---
SCREENSHOT_DIR=screenshots
LOG_DIR=logs
MAX_SCREENSHOTS=500                         # Auto-purge oldest after this limit

# --- Dashboard ---
DASHBOARD_PORT=8501
API_PORT=8000
